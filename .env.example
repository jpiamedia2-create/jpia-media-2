# ---- Cloudinary (Dashboard > Settings > API Keys) ----
# Either the single URL...
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or the three separate values:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- App ----
# Long random text; signs login sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# First JPIA President access key (min 6 characters) and display name
PRESIDENT_KEY=
PRESIDENT_NAME=President

# ---- Optional ----
# KEY_SECRET=                    # encrypts access keys inside Cloudinary. Defaults to SESSION_SECRET. Set it once and never change it (changing it makes saved keys unreadable; use RESET_PRESIDENT to recover).
# CLOUDINARY_FOLDER=jpia-media   # folder inside your Cloudinary library
# MAX_UPLOAD_MB=10               # per photo (free Cloudinary plan limit is 10 MB; larger photos are auto-shrunk in the browser)
# STORAGE_LIMIT_GB=25            # used only if Cloudinary does not report a storage percentage
# SESSION_HOURS=12
# RESET_PRESIDENT=1              # set once to overwrite a forgotten President key with PRESIDENT_KEY, then remove
